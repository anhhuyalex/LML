+++ b/templates/html/book-nav.css
@@ -0,0 +1,56 @@
+/* The Contents pane of the book pages: header buttons, splitter, whole-book tree, collapsed state.
+   The grid itself (three columns: pane, splitter, pages) is declared in book.html.
+   book-nav.js sets --nav-width and html[data-nav="collapsed"]. */
+
+[hidden] { display: none !important; }
+
+/* ---- header of the pane ---- */
+.nav-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
+.nav-head h1 { margin: 0; }
+#nav-hide, #nav-show {
+  font: 13px system-ui, sans-serif; color: inherit; background: #fff; cursor: pointer;
+  border: 1px solid #c9c3b6; border-radius: 6px; padding: 3px 9px;
+}
+#nav-hide:hover, #nav-show:hover { background: #f5f2ec; }
+#nav-hide:focus-visible, #nav-show:focus-visible, #book-home:focus-visible { outline: 2px solid #526a58; outline-offset: 2px; }
+#nav-show { position: fixed; top: 12px; left: 12px; z-index: 5; box-shadow: 0 2px 8px #302a2026; }
+#book-home { display: inline-block; margin: 10px 0 0; color: #245b96; text-decoration: none; }
+#book-home:hover { text-decoration: underline; text-underline-offset: 3px; }
+
+/* ---- splitter: a 28px column whose middle line is the visible handle ---- */
+#nav-resizer {
+  position: sticky; top: 28px; align-self: start; height: calc(100dvh - 56px);
+  cursor: col-resize; touch-action: none;
+}
+#nav-resizer::before {
+  content: ""; position: absolute; top: 0; bottom: 0; left: 13px; width: 2px;
+  background: #d8d2c5; border-radius: 1px;
+}
+#nav-resizer:hover::before, #nav-resizer:focus-visible::before, body.nav-dragging #nav-resizer::before { background: #526a58; }
+#nav-resizer:focus-visible { outline: none; }
+body.nav-dragging { user-select: none; cursor: col-resize; }
+
+/* ---- whole-book tree ---- */
+#book-tree { margin-top: 10px; }
+#book-tree ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; line-height: 1.4; }
+#book-tree ol ol { margin-top: 6px; padding-left: 14px; font-size: 14px; }
+#book-tree details { margin: 0; }
+#book-tree summary { cursor: pointer; padding: 2px 0; }
+#book-tree .leaf > summary { list-style: none; cursor: default; }
+#book-tree .leaf > summary::-webkit-details-marker { display: none; }
+#book-tree a { color: inherit; text-decoration: none; }
+#book-tree a:hover { text-decoration: underline; text-underline-offset: 3px; }
+#book-tree a:focus-visible { outline: 2px solid #526a58; outline-offset: 3px; }
+#book-tree [aria-current="page"] > summary > a, #book-tree a[aria-current="location"] { font-weight: 600; color: #1f3b2a; }
+#book-tree a[aria-current="location"] { text-decoration: underline; text-underline-offset: 3px; }
+.tree-meta { color: #626a64; font-size: 12px; margin-left: 4px; white-space: nowrap; }
+.tree-neighbours, .tree-links { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 14px 0 0; font-size: 14px; }
+.tree-links a, .tree-neighbours a { color: #245b96; text-decoration: none; }
+.tree-links a:hover, .tree-neighbours a:hover { text-decoration: underline; }
+
+/* ---- collapsed: the pages take the freed width ---- */
+html[data-nav="collapsed"] .reader { display: block; max-width: 1100px; }
+html[data-nav="collapsed"] aside,
+html[data-nav="collapsed"] #nav-resizer { display: none; }
+
+@media (max-width: 700px) { #nav-resizer { display: none; } }
