/-!
# Measurable maps into the space of probability measures

`ProbabilityMeasure X` carries two natural σ-algebras: the Giry σ-algebra generated by the
evaluations `ν ↦ ν s` (the Mathlib instance), and the Borel σ-algebra of the topology of weak
convergence.  They coincide on a separable metric space; Mathlib does not record this.  We prove
the inclusion that is easy to prove and sufficient for limits:

* `MeasureTheory.ProbabilityMeasure.measurable_coe_borel`: the evaluations `ν ↦ ν s` are
  Borel measurable for the weak topology, so a Borel measurable map into `ProbabilityMeasure X` is
  Giry measurable (`MeasureTheory.ProbabilityMeasure.measurable_of_borel`).
* `MeasureTheory.continuous_toProbabilityMeasure_empiricalMeasure`: the empirical measure of a
  finite family is a continuous function of the family.
* `MeasureTheory.exists_measurable_tendsto_empiricalMeasure`: for measurable random points `y i b`
  in a Polish space, the set of `b` where the empirical measures converge weakly is measurable and
  the limit is a measurable function of `b` on it.

## Implementation notes

Mathlib does not know that `ProbabilityMeasure X` is completely metrizable for a Polish space `X`,
which would give the measurability of the set of convergence directly.  We embed `X` in the Hilbert
cube `Q` (`Metric.PiNatEmbed.exists_embedding_to_hilbert_cube`); `ProbabilityMeasure Q` is compact
metrizable, so `StronglyMeasurable.measurableSet_exists_tendsto` and `StronglyMeasurable.limUnder`
apply there.  A sequence of probability measures on `X` converges iff its image in `Q` converges to
a measure carried by `X` (portmanteau, as the open sets of `X` are traces of open sets of `Q`), and
the limit is pulled back along the measurable embedding.
-/

@[expose] public section

open MeasureTheory Filter Topology TopologicalSpace
open scoped ENNReal NNReal unitInterval

namespace MeasureTheory

/-- The empirical measure `(card ι)⁻¹ ∑_i δ_{x i}` is a continuous function of the finite family
`x`, for the topology of weak convergence. -/
theorem continuous_toProbabilityMeasure_empiricalMeasure {X : Type*} [TopologicalSpace X]
    [MeasurableSpace X] [OpensMeasurableSpace X] [MeasurableSingletonClass X] {ι : Type*}
    [Fintype ι] [Nonempty ι] :
    Continuous fun x : ι → X => (empiricalMeasure x).toProbabilityMeasure := by
  rw [ProbabilityMeasure.continuous_iff_forall_continuous_integral]
  intro f
  simp only [Measure.coe_toProbabilityMeasure, integral_empiricalMeasure]
  fun_prop

section PseudoMetrizable

variable {X : Type*} [TopologicalSpace X] [PseudoMetrizableSpace X] [MeasurableSpace X]
  [BorelSpace X]

/-- **The evaluations `ν ↦ ν s` are Borel measurable for the weak topology:** the Giry σ-algebra
on `ProbabilityMeasure X` is contained in the Borel σ-algebra of the topology of weak convergence.
For a closed set `F`, `ν F` is the limit of the continuous functions
`ν ↦ ∫ (thickened indicator of F) dν`, and closed sets form a generating `π`-system. -/
theorem ProbabilityMeasure.measurable_coe_borel :
    Measurable[borel (ProbabilityMeasure X)] fun ν : ProbabilityMeasure X => (ν : Measure X) := by
  let _ := pseudoMetrizableSpacePseudoMetric X
  let _ : MeasurableSpace (ProbabilityMeasure X) := borel _
  have _ : BorelSpace (ProbabilityMeasure X) := ⟨rfl⟩
  refine Measurable.measure_of_isPiSystem_of_isProbabilityMeasure
    (S := {F : Set X | IsClosed F}) ?_ isPiSystem_isClosed ?_
  · rw [BorelSpace.measurable_eq (α := X), borel_eq_generateFrom_isClosed]
  · intro F hF
    have hpos : ∀ k : ℕ, (0 : ℝ) < 1 / ((k : ℝ) + 1) := fun k => by positivity
    have hlim : Tendsto (fun (k : ℕ) (ν : ProbabilityMeasure X) =>
        ∫⁻ x, (thickenedIndicator (hpos k) F x : ℝ≥0∞) ∂(ν : Measure X)) atTop
        (𝓝 fun ν : ProbabilityMeasure X => (ν : Measure X) F) :=
      tendsto_pi_nhds.2 fun ν => tendsto_lintegral_thickenedIndicator_of_isClosed (ν : Measure X)
        hF hpos tendsto_one_div_add_atTop_nhds_zero_nat
    refine measurable_of_tendsto_metrizable (fun k => ?_) hlim
    exact (ProbabilityMeasure.continuous_lintegral_boundedContinuousFunction
      (thickenedIndicator (hpos k) F)).measurable

/-- A map into `ProbabilityMeasure X` that is Borel measurable for the topology of weak convergence
is measurable for the Giry σ-algebra. -/
theorem ProbabilityMeasure.measurable_of_borel {α : Type*} [MeasurableSpace α]
    {g : α → ProbabilityMeasure X}
    (hg : @Measurable α (ProbabilityMeasure X) _ (borel _) g) : Measurable g :=
  Measurable.subtype_mk (ProbabilityMeasure.measurable_coe_borel.comp hg)

end PseudoMetrizable

variable {X : Type*} [MetricSpace X] [MeasurableSpace X] [BorelSpace X]

/-- **The set where the empirical measures converge weakly is measurable, and the limit is a
measurable function there.**  Let `y i : β → X` be measurable random points in a Polish space.
The set of `b` for which the empirical measures `(n + 1)⁻¹ ∑_{i ≤ n} δ_{y i b}` converge weakly is
measurable, and the limit can be chosen as a (Giry) measurable function `g` of `b` on it. -/
theorem exists_measurable_tendsto_empiricalMeasure [PolishSpace X] {β : Type*}
    [MeasurableSpace β] {y : ℕ → β → X} (hy : ∀ i, Measurable (y i)) :
    MeasurableSet {b | ∃ ν : ProbabilityMeasure X,
      Tendsto (fun n : ℕ => (empiricalMeasure fun i : Fin (n + 1) => y i b).toProbabilityMeasure)
        atTop (𝓝 ν)} ∧
    ∃ g : β → ProbabilityMeasure X, Measurable g ∧ ∀ b, (∃ ν : ProbabilityMeasure X,
      Tendsto (fun n : ℕ => (empiricalMeasure fun i : Fin (n + 1) => y i b).toProbabilityMeasure)
        atTop (𝓝 ν)) →
      Tendsto (fun n : ℕ => (empiricalMeasure fun i : Fin (n + 1) => y i b).toProbabilityMeasure)
        atTop (𝓝 (g b)) := by
  classical
  obtain ⟨ι, hι⟩ := Metric.PiNatEmbed.exists_embedding_to_hilbert_cube (X := X)
  have hιm : MeasurableEmbedding ι := hι.continuous.measurableEmbedding hι.injective
  set T : ℕ → β → ProbabilityMeasure X := fun n b =>
    (empiricalMeasure fun i : Fin (n + 1) => y i b).toProbabilityMeasure with hT
  set T' : ℕ → β → ProbabilityMeasure (ℕ → I) := fun n b =>
    (empiricalMeasure fun i : Fin (n + 1) => ι (y i b)).toProbabilityMeasure with hT'
  have hTT' : ∀ n b, T' n b = (T n b).map ι := fun n b => by
    refine ProbabilityMeasure.toMeasure_injective ?_
    simp only [hT', hT, Measure.coe_toProbabilityMeasure, ProbabilityMeasure.toMeasure_map]
    rw [map_empiricalMeasure _ hι.continuous.measurable]
    rfl
  have hcm : IsCompletelyMetrizableSpace (ProbabilityMeasure (ℕ → I)) := by
    let := TopologicalSpace.metrizableSpaceMetric (ProbabilityMeasure (ℕ → I))
    have : CompleteSpace (ProbabilityMeasure (ℕ → I)) := complete_of_compact
    exact MetricSpace.toIsCompletelyMetrizableSpace
  have hT'sm : ∀ n, StronglyMeasurable (T' n) := fun n => by
    have hmeas : Measurable fun b => fun i : Fin (n + 1) => ι (y i b) :=
      measurable_pi_iff.2 fun i => hι.continuous.measurable.comp (hy i)
    exact (continuous_toProbabilityMeasure_empiricalMeasure
      (ι := Fin (n + 1))).comp_stronglyMeasurable hmeas.stronglyMeasurable
  have hconv' : MeasurableSet {b | ∃ c, Tendsto (fun n => T' n b) atTop (𝓝 c)} :=
    StronglyMeasurable.measurableSet_exists_tendsto hT'sm
  have hne : Nonempty (ProbabilityMeasure (ℕ → I)) :=
    ⟨(Measure.dirac (fun _ : ℕ => (0 : I))).toProbabilityMeasure⟩
  set L : β → ProbabilityMeasure (ℕ → I) := fun b => limUnder atTop (fun n => T' n b) with hL
  have hLsm : StronglyMeasurable L := StronglyMeasurable.limUnder hT'sm
  have hLS : ∀ S : Set (ℕ → I), MeasurableSet S →
      Measurable fun b => (L b : Measure (ℕ → I)) S := by
    intro S hS
    let _ : MeasurableSpace (ProbabilityMeasure (ℕ → I)) := borel _
    have _ : BorelSpace (ProbabilityMeasure (ℕ → I)) := ⟨rfl⟩
    exact (Measure.measurable_coe hS).comp
      (ProbabilityMeasure.measurable_coe_borel.comp hLsm.measurable)
  set C : Set β := {b | ∃ ν : ProbabilityMeasure X, Tendsto (fun n => T n b) atTop (𝓝 ν)} with hC
  have hrange : MeasurableSet (Set.range ι) := hιm.measurableSet_range
  have hprob : ∀ b : β, (L b : Measure (ℕ → I)) (Set.range ι) = 1 →
      IsProbabilityMeasure ((L b : Measure (ℕ → I)).comap ι) := fun b h1 =>
    ⟨by rw [hιm.comap_apply, Set.image_univ]; exact h1⟩
  -- conversely, if the compactified measures converge to a measure carried by `range ι`, the
  -- original ones converge to its restriction
  have hlim : ∀ (b : β) (hc : ∃ c, Tendsto (fun n => T' n b) atTop (𝓝 c))
      (h1 : (L b : Measure (ℕ → I)) (Set.range ι) = 1),
      Tendsto (fun n => T n b) atTop
        (𝓝 (⟨(L b : Measure (ℕ → I)).comap ι, hprob b h1⟩ : ProbabilityMeasure X)) := by
    intro b hc h1
    obtain ⟨c, hc⟩ := hc
    have hLc : L b = c := hc.limUnder_eq
    have hc' : Tendsto (fun n => T' n b) atTop (𝓝 (L b)) := by rw [hLc]; exact hc
    refine tendsto_of_forall_isOpen_le_liminf' fun G hG => ?_
    obtain ⟨G', hG'o, rfl⟩ := hι.isInducing.isOpen_iff.1 hG
    have hl := ProbabilityMeasure.le_liminf_measure_open_of_tendsto hc' hG'o
    have hlhs : ((⟨(L b : Measure (ℕ → I)).comap ι, hprob b h1⟩ : ProbabilityMeasure X) :
        Measure X) (ι ⁻¹' G') = (L b : Measure (ℕ → I)) G' := by
      change (L b : Measure (ℕ → I)).comap ι (ι ⁻¹' G') = _
      rw [hιm.comap_apply, Set.image_preimage_eq_inter_range]
      exact measure_inter_conull (by rwa [prob_compl_eq_zero_iff hrange])
    refine (le_of_eq hlhs).trans (hl.trans (le_of_eq ?_))
    congr 1
    ext n
    rw [hTT', ProbabilityMeasure.toMeasure_map, Measure.map_apply hι.continuous.measurable
      hG'o.measurableSet]
  have hCeq : C = {b | ∃ c, Tendsto (fun n => T' n b) atTop (𝓝 c)} ∩
      {b | (L b : Measure (ℕ → I)) (Set.range ι) = 1} := by
    ext b
    constructor
    · rintro ⟨ν, hν⟩
      have h1 : Tendsto (fun n => T' n b) atTop (𝓝 (ν.map ι)) := by
        simp only [hTT']
        exact ProbabilityMeasure.tendsto_map_of_tendsto_of_continuous (fun n => T n b) ν hν
          hι.continuous
      refine ⟨⟨_, h1⟩, ?_⟩
      have hLc : L b = ν.map ι := h1.limUnder_eq
      change (L b : Measure (ℕ → I)) (Set.range ι) = 1
      rw [hLc, ProbabilityMeasure.toMeasure_map,
        Measure.map_apply hι.continuous.measurable hrange, Set.preimage_range]
      exact measure_univ
    · rintro ⟨hc, h1⟩
      exact ⟨_, hlim b hc h1⟩
  have hCm : MeasurableSet C := by
    rw [hCeq]
    exact hconv'.inter (hLS _ hrange (measurableSet_singleton 1))
  have hT0 : Measurable fun b => (T 0 b : Measure X) := by
    simp only [hT, Measure.coe_toProbabilityMeasure]
    exact measurable_empiricalMeasure.comp (measurable_pi_iff.2 fun i => hy i)
  let g : β → ProbabilityMeasure X := fun b =>
    if h : b ∈ C then ⟨(L b : Measure (ℕ → I)).comap ι, hprob b (by rw [hCeq] at h; exact h.2)⟩
    else T 0 b
  refine ⟨hCm, g, ?_, fun b hb => ?_⟩
  · have hgm : Measurable fun b => (g b : Measure X) := by
      refine Measure.measurable_of_measurable_coe _ fun s hs => ?_
      have : (fun b => (g b : Measure X) s) =
          fun b => if b ∈ C then (L b : Measure (ℕ → I)) (ι '' s) else (T 0 b : Measure X) s := by
        ext b
        by_cases h : b ∈ C
        · simp only [g, h, ↓reduceDIte, ↓reduceIte]
          exact hιm.comap_apply _ _
        · simp only [g, h, ↓reduceDIte, ↓reduceIte]
      rw [this]
      exact Measurable.ite hCm (hLS _ (hιm.measurableSet_image.2 hs))
        ((Measure.measurable_coe hs).comp hT0)
    exact hgm.subtype_mk
  · have hb' : b ∈ C := hb
    have h2 := hb'
    rw [hCeq] at h2
    have := hlim b h2.1 h2.2
    simpa only [g, hb', ↓reduceDIte] using this

end MeasureTheory
