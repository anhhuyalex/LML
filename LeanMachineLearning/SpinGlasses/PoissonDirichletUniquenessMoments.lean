module

public import LeanMachineLearning.SpinGlasses.PoissonDirichletUniqueness
public import Mathlib.MeasureTheory.Measure.HasOuterApproxClosed

/-!
# Moment comparison on the Poisson--Dirichlet simplex

The analytic uniqueness step is independent of the Ghirlanda--Guerra recurrence:
if two probability laws agree on products of the higher power sums, then they
agree as measures on the compact simplex. Talagrand's identities provide the
moment equalities in a subsequent step.
-/

@[expose] public section

open MeasureTheory

namespace SpinGlasses

/-- A continuous real function on a compact space is integrable against any finite measure. -/
private theorem integrable_continuousMap {X : Type*} [TopologicalSpace X] [CompactSpace X]
    [MeasurableSpace X] [OpensMeasurableSpace X] (μ : Measure X) [IsFiniteMeasure μ]
    (f : C(X, ℝ)) :
    Integrable (fun x => f x) μ :=
  f.continuous.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace f)

/-- Integrals against a finite measure vary continuously with a continuous
function on the compact simplex in the uniform norm. -/
private theorem continuous_simplex_integral (μ : Measure 𝕍)
    [IsFiniteMeasure μ] :
    Continuous (fun f : C(𝕍, ℝ) =>
      ∫ x, f x ∂μ) := by
  apply (LipschitzWith.of_dist_le_mul (K := ENNReal.toNNReal (μ Set.univ) + 1)
    (fun f g => ?_)).continuous
  have hf : Integrable (fun x => f x) μ :=
    integrable_continuousMap μ f
  have hg : Integrable (fun x => g x) μ :=
    integrable_continuousMap μ g
  rw [dist_eq_norm, ← integral_sub hf hg]
  calc
    ‖∫ x, (f x - g x) ∂μ‖ ≤ ‖f - g‖ * μ.real Set.univ := by
      apply norm_integral_le_of_norm_le_const
      filter_upwards [] with x
      simpa only [ContinuousMap.sub_apply] using
        ContinuousMap.norm_coe_le_norm (f - g) x
    _ ≤ (μ.real Set.univ + 1) * ‖f - g‖ := by
      rw [mul_comm ‖f - g‖]
      exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_right (by norm_num))
        (norm_nonneg _)
    _ = ↑((μ Set.univ).toNNReal + 1) * dist f g := by
      simp [Measure.real, dist_eq_norm, ENNReal.toReal, ENNReal.toNNReal]

/-- Equality on an algebra dense in the continuous functions determines a
finite Borel measure on the decreasing simplex. -/
theorem poissonDirichletSimplex_measure_ext_of_algebra
    (μ ν : Measure 𝕍)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ f ∈ poissonDirichletPowerSumAlgebra,
      (∫ x, f x ∂μ) = ∫ x, f x ∂ν) : μ = ν := by
  have hclosed : IsClosed {f : C(𝕍, ℝ) |
      (∫ x, f x ∂μ) = ∫ x, f x ∂ν} :=
    isClosed_eq (continuous_simplex_integral μ) (continuous_simplex_integral ν)
  have hall : ∀ f : C(𝕍, ℝ),
      (∫ x, f x ∂μ) = ∫ x, f x ∂ν := by
    intro f
    have hsub : (poissonDirichletPowerSumAlgebra :
        Set C(𝕍, ℝ)) ⊆
        {g | (∫ x, g x ∂μ) = ∫ x, g x ∂ν} := fun g hg => h g hg
    have hdense : closure (poissonDirichletPowerSumAlgebra :
        Set C(𝕍, ℝ)) = Set.univ := by
      rw [← Subalgebra.topologicalClosure_coe,
        poissonDirichletPowerSumAlgebra_dense]
      rfl
    exact (hclosed.closure_subset_iff.mpr hsub)
      (by rw [hdense]; trivial)
  apply ext_of_forall_integral_eq_of_IsFiniteMeasure
  intro f
  exact hall f.toContinuousMap

/-- The algebra generated by higher power sums is spanned by finite products
of those power sums. This reduces measure uniqueness to mixed moments. -/
theorem poissonDirichletPowerSumAlgebra_le_of_products
    (T : Submodule ℝ C(𝕍, ℝ))
    (hone : (1 : C(𝕍, ℝ)) ∈ T)
    (hgen : ∀ (s : ℕ) (hs : 2 ≤ s) (f : C(𝕍, ℝ)),
      f ∈ T → poissonDirichletPowerSum s hs * f ∈ T) :
    poissonDirichletPowerSumAlgebra.toSubmodule ≤ T := by
  rw [poissonDirichletPowerSumAlgebra, Algebra.adjoin_eq_span]
  apply Submodule.span_le.mpr
  intro f hf
  have hproduct : ∀ f ∈ Submonoid.closure
      {g : C(𝕍, ℝ) |
        ∃ s : ℕ, ∃ hs : 2 ≤ s, g = poissonDirichletPowerSum s hs},
      ∀ g ∈ T, f * g ∈ T := by
    intro f hf
    induction hf using Submonoid.closure_induction with
    | mem f hf =>
        obtain ⟨s, hs, rfl⟩ := hf
        exact hgen s hs
    | one =>
        intro g hg
        simpa only [one_mul] using hg
    | mul f g hf hg ihf ihg =>
        intro k hk
        rw [mul_assoc]
        exact ihf _ (ihg _ hk)
  change f ∈ T
  simpa only [mul_one] using hproduct f hf 1 hone

/-- Mixed moments of the higher power sums determine a finite Borel law on
`V`. The empty product records its total mass. No normalization or positivity
beyond finite measures is needed for this deterministic uniqueness theorem. -/
theorem poissonDirichletSimplex_measure_ext_of_powerSum_products
    (μ ν : Measure 𝕍)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ (k : ℕ) (s : Fin k → ℕ) (hs : ∀ i, 2 ≤ s i),
      (∫ x, ∏ i, (poissonDirichletPowerSum (s i) (hs i)) x ∂μ) =
      ∫ x, ∏ i, (poissonDirichletPowerSum (s i) (hs i)) x ∂ν) : μ = ν := by
  let T : Submodule ℝ C(𝕍, ℝ) :=
    Submodule.span ℝ {f : C(𝕍, ℝ) |
      ∃ (k : ℕ) (s : Fin k → ℕ) (hs : ∀ i, 2 ≤ s i),
        f = ∏ i, poissonDirichletPowerSum (s i) (hs i)}
  have hone : (1 : C(𝕍, ℝ)) ∈ T := by
    apply Submodule.subset_span
    exact ⟨0, Fin.elim0, (fun i => i.elim0), by simp⟩
  have hgen : ∀ (s : ℕ) (hs : 2 ≤ s) (f : C(𝕍, ℝ)),
      f ∈ T → poissonDirichletPowerSum s hs * f ∈ T := by
    intro s hs f hf
    induction hf using Submodule.span_induction with
    | mem f hf =>
        obtain ⟨k, t, ht, rfl⟩ := hf
        apply Submodule.subset_span
        refine ⟨k + 1, Fin.cons s t, Fin.cons hs ht, ?_⟩
        simp only [Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ]
    | zero => simp
    | add f g hf hg ihf ihg =>
        simpa only [mul_add] using T.add_mem ihf ihg
    | smul r f hf ih =>
        convert T.smul_mem r ih using 1
        ext x
        simp only [ContinuousMap.mul_apply, ContinuousMap.smul_apply,
          smul_eq_mul]
        ring
  have hle := poissonDirichletPowerSumAlgebra_le_of_products T hone hgen
  let E : Submodule ℝ C(𝕍, ℝ) :=
    { carrier := {f | (∫ x, f x ∂μ) = ∫ x, f x ∂ν}
      add_mem' := by
        intro f g hf hg
        have hfμ : Integrable (fun x => f x) μ :=
          integrable_continuousMap μ f
        have hgμ : Integrable (fun x => g x) μ :=
          integrable_continuousMap μ g
        have hfν : Integrable (fun x => f x) ν :=
          integrable_continuousMap ν f
        have hgν : Integrable (fun x => g x) ν :=
          integrable_continuousMap ν g
        change (∫ x, (f + g) x ∂μ) = ∫ x, (f + g) x ∂ν
        simp only [ContinuousMap.add_apply, integral_add hfμ hgμ,
          integral_add hfν hgν]
        exact congrArg₂ (· + ·) hf hg
      zero_mem' := by
        change (∫ x, (0 : C(𝕍, ℝ)) x ∂μ) =
          ∫ x, (0 : C(𝕍, ℝ)) x ∂ν
        simp
      smul_mem' := by
        intro r f hf
        change (∫ x, (r • f) x ∂μ) = ∫ x, (r • f) x ∂ν
        simp only [ContinuousMap.smul_apply, smul_eq_mul,
          integral_const_mul]
        exact congrArg (r * ·) hf }
  have hTE : T ≤ E := by
    apply Submodule.span_le.mpr
    intro f hf
    obtain ⟨k, s, hs, rfl⟩ := hf
    change (∫ x, (∏ i, poissonDirichletPowerSum (s i) (hs i)) x ∂μ) =
      ∫ x, (∏ i, poissonDirichletPowerSum (s i) (hs i)) x ∂ν
    convert h k s hs using 1 <;> congr 1 <;> ext x <;>
      simp only [ContinuousMap.prod_apply]
  apply poissonDirichletSimplex_measure_ext_of_algebra
  intro f hf
  exact hTE (hle hf)

/-- A sequence of nonnegative weights summing to one and decreasing in rank
belongs to the compact simplex (which also includes subprobability limits). -/
theorem mem_poissonDirichletSimplex_of_hasSum
    {w : ℕ → ℝ} (hw0 : ∀ j, 0 ≤ w j) (hanti : Antitone w)
    (hs : HasSum w 1) : w ∈ 𝕍 := by
  refine ⟨hw0, hanti, ?_⟩
  rw [← ENNReal.ofReal_tsum_of_nonneg hw0 hs.summable]
  simp [hs.tsum_eq]

/-- Every independent-block realization of the zeta-Poisson process has its
ranked Poisson--Dirichlet weights in the compact simplex almost surely. -/
theorem ae_poissonDirichletWeight_mem_simplex_of_blocks
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {ζ : ℝ} (hζ0 : 0 < ζ) (hζ1 : ζ < 1)
    (ν : ℕ → Measure ℝ) [∀ n, IsProbabilityMeasure (ν n)] (r : ℕ → NNReal)
    {B : ℕ → Ω → ℕ × (ℕ → ℝ)}
    (hBm : ∀ n, Measurable (B n)) (hB : ProbabilityTheory.iIndepFun B P)
    (hlaw : ∀ n, ProbabilityTheory.HasLaw (B n)
      ((ProbabilityTheory.poissonMeasure (r n)).prod
        (Measure.infinitePi fun _ : ℕ => ν n)) P)
    (hμ : zetaPoissonMeasure ζ = Measure.sum (fun n => (r n : ENNReal) • ν n)) :
    ∀ᵐ ω ∂P, (fun k => poissonDirichletWeight k
      (poissonCountingMeasure (fun n => (B n ω).1)
        (fun n l => (B n ω).2 l))) ∈ 𝕍 := by
  have h := ae_poissonDirichletWeight ν r hζ0 hζ1 hBm hB hlaw hμ
    (fun ω => rfl)
  filter_upwards [h] with ω hω
  exact mem_poissonDirichletSimplex_of_hasSum
    (fun k => (hω.2.2.2.1 k).le) hω.2.2.2.2 hω.2.2.1

/-- The ranked-weight law is supported on the compact simplex. The source
measure is any unmarked independent-block realization of zeta intensity. -/
theorem map_poissonDirichletWeight_simplex_compl_eq_zero_of_blocks
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {ζ : ℝ} (hζ0 : 0 < ζ) (hζ1 : ζ < 1)
    (ν : ℕ → Measure ℝ) [∀ n, IsProbabilityMeasure (ν n)] (r : ℕ → NNReal)
    {B : ℕ → Ω → ℕ × (ℕ → ℝ)}
    (hBm : ∀ n, Measurable (B n)) (hB : ProbabilityTheory.iIndepFun B P)
    (hlaw : ∀ n, ProbabilityTheory.HasLaw (B n)
      ((ProbabilityTheory.poissonMeasure (r n)).prod
        (Measure.infinitePi fun _ : ℕ => ν n)) P)
    (hμ : zetaPoissonMeasure ζ = Measure.sum (fun n => (r n : ENNReal) • ν n)) :
    (P.map (fun ω k => poissonDirichletWeight k
      (poissonCountingMeasure (fun n => (B n ω).1)
        (fun n l => (B n ω).2 l)))) (𝕍)ᶜ = 0 := by
  have hm : Measurable (fun ω k => poissonDirichletWeight k
      (poissonCountingMeasure (fun n => (B n ω).1)
        (fun n l => (B n ω).2 l))) :=
    (measurable_pi_iff.2 measurable_poissonDirichletWeight).comp
      (measurable_poissonCountingMeasure_of_blocks hBm (fun ω => rfl))
  rw [Measure.map_apply hm isClosed_poissonDirichletSimplex.measurableSet.compl]
  exact ae_poissonDirichletWeight_mem_simplex_of_blocks
    hζ0 hζ1 ν r hBm hB hlaw hμ

end SpinGlasses
